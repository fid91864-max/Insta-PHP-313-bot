{
  "version": 2,
  "functions": {
    "api/insta.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 512,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/api/insta",
      "dest": "/api/insta.php"
    },
    {
      "src": "/api/insta.php",
      "dest": "/api/insta.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
